<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{{title}} | Node Course</title>
    <link rel="stylesheet" href="/assets/css/main.css" />
    <script src="/assets/js/main.js" defer></script>
  </head>
  <body id="top">
    <div class="page-shell error-shell">
      {{> header}}
      <main class="error-page">
        <div class="error-code" aria-hidden="true">404</div>
        <p class="eyebrow"><span></span> Route not found</p>
        <h1>This path left the <em>server map.</em></h1>
        <p>The route <code>{{requestedUrl}}</code> does not exist or may have moved.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/">Return home</a>
          <a class="text-link" href="/generic">Review the routes <span>→</span></a>
        </div>
      </main>
      {{> footer}}
    </div>
  </body>
</html>
